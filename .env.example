# Copia este archivo a .env y ajusta los valores.
# El archivo .env real NO se sube al repositorio (esta en .gitignore).

# --- Base de datos (Postgres) ---
POSTGRES_USER=appfinanzas
POSTGRES_PASSWORD=cambia_esta_clave_en_local
POSTGRES_DB=appfinanzas

# Cadena de conexion que usa la API para hablar con Postgres.
# El host "db" es el nombre del servicio en docker-compose, no "localhost".
DATABASE_URL=postgres://appfinanzas:cambia_esta_clave_en_local@db:5432/appfinanzas

# --- API ---
# Puerto interno de la API dentro del contenedor (no suele cambiarse).
API_PORT=3000
# Puerto por el que accedes a la API desde tu maquina (host).
# Se eligio 3001 porque el 3000 ya estaba ocupado por otra app.
API_HOST_PORT=3001
# Secreto para firmar los tokens de sesion (JWT). En local puede ser cualquier
# texto largo; en produccion debe ser aleatorio y privado.
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# --- Frontend (web) ---
# Puerto por el que accedes a la app desde tu maquina (host).
# Se eligio 5174 porque el 5173 ya estaba ocupado por otra app.
WEB_HOST_PORT=5174
# VITE_API_URL es OPCIONAL. Si se deja vacio, la app deriva la URL de la API del
# host por el que se abre (localhost o la IP de la red local). Solo se define
# para forzar una URL fija (por ejemplo en produccion).
VITE_API_URL=
