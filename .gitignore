# Dependencias
node_modules/
.pnp
.pnp.js
.yarn/

# Builds / salida
dist/
build/
out/
.vite/
*.tsbuildinfo

# Variables de entorno y secretos (¡nunca al repo!)
.env
.env.*
!.env.example
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Respaldos y volcados de la base (no deben ir al repo)
*.sqlite
*.sqlite3
*.dump
backups/
pgdata/
# Ignoramos .sql sueltos (por si son dumps), PERO el esquema y las migraciones
# SÍ tienen que ir al repo (los necesita el deploy):
*.sql
!db/init.sql
!db/migrations/
!db/migrations/*.sql

# Cachés y herramientas
.cache/
.eslintcache
coverage/
.parcel-cache/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db

