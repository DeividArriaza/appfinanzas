# SITE_ADDRESS define como se publica:
#   ":80"                -> HTTP por IP (para probar sin dominio)
#   "cuencla.duckdns.org"-> Caddy saca y renueva HTTPS automatico
{$SITE_ADDRESS} {
	encode gzip

	# HSTS: una vez que el navegador visita por HTTPS, fuerza https siempre
	# para este dominio (evita volver a caer en http). Se recibe por la
	# conexion HTTPS del Caddy del host, asi que el navegador lo respeta.
	header Strict-Transport-Security "max-age=31536000"

	# Las llamadas a /api/* van a la API (se quita el prefijo /api).
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# El resto sirve el frontend (SPA: rutas desconocidas -> index.html).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
